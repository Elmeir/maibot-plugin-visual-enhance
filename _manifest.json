{
  "manifest_version": 2,
  "version": "2.0.0",
  "id": "github.elmeir.visual-enhance",
  "name": "视觉增强",
  "description": "GIF 动图分镜、图片重看（含表情包）、B站/抖音视频理解三合一：动图按帧合成网格图交给视觉模型；描述不够时可带问题重新看图；视频链接自动附加信息与官方 AI 总结（需登录态）。纯插件实现，不改宿主代码。",
  "author": {
    "name": "Elmeir",
    "url": "https://github.com/Elmeir"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/Elmeir/maibot-plugin-visual-enhance",
    "homepage": "https://github.com/Elmeir/maibot-plugin-visual-enhance",
    "documentation": "https://github.com/Elmeir/maibot-plugin-visual-enhance#readme",
    "issues": "https://github.com/Elmeir/maibot-plugin-visual-enhance/issues"
  },
  "host_application": {
    "min_version": "1.2.4",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.8.1",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "Pillow",
      "version_spec": ">=10.0.0"
    },
    {
      "type": "python_package",
      "name": "aiohttp",
      "version_spec": ">=3.8.0"
    },
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.27.0"
    },
    {
      "type": "python_package",
      "name": "bilibili-api-python",
      "version_spec": ">=17.4.0"
    }
  ],
  "capabilities": [
    "database.query",
    "llm.generate",
    "message.get_recent"
  ],
  "plugin_type": "extension",
  "display": {
    "icon": {
      "type": "emoji",
      "value": "🎞️"
    }
  },
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
